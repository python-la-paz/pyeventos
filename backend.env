APP_DB_TYPE=postgresql
APP_HOST_DB=your-neon-host.neon.tech
APP_PORT_DB=5432
APP_NAME_DB=neondb
APP_USER_DB=neondb_owner
APP_PASSWORD_DB=your-neon-password
